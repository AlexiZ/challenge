# Variables de prod, figées dans .env.local.php au build. Copier en .env.prod.local (non versionné).
APP_SECRET=
# Identifiants dans l'espace client OVH : Web Cloud > Hébergements > Bases de données
DATABASE_URL="mysql://USER:PASSWORD@SERVER:3306/DATABASE?serverVersion=8.4.0&charset=utf8mb4"
MAILER_DSN="brevo+api://CLE@default"
