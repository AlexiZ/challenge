{% extends 'base.html.twig' %}

{% block title %}{{ team.name }} | {{ parent() }}{% endblock %}

{% block body %}
<div class="home-wrap">
    {# Breadcrumb #}
    <nav class="td-breadcrumb">
        <a href="{{ path('app_participants', {citySlug: city.slug}) }}">Équipes &amp; Participants</a>
        <span class="td-breadcrumb__sep">›</span>
        <span>{{ team.name }}</span>
    </nav>

    <div class="td-layout">
        {# ════════════════════════ MAIN ════════════════════════ #}
        <div class="td-main">
            {# Team header card #}
            <div class="td-header-card">
                <div class="td-header-card__top">
                    <div class="td-header-badge">{{ team.initials }}</div>
                    <div class="td-header-info">
                        <h1 class="td-header-name">{{ team.name }}</h1>
                        <div class="td-header-meta">
                            <span><i class="fas fa-building fa-xs"></i> Équipe {{ team.isPublic ? 'publique' : 'privée' }}</span>
                            <span><i class="fas fa-circle fa-xs td-live-dot"></i> {{ team.memberCount }} membre{{ team.memberCount > 1 ? 's' : '' }}</span>
                            <span><i class="fas fa-calendar-alt fa-xs"></i> Créée en {{ team.createdAt|date('Y') }}</span>
                        </div>
                    </div>
                    {% if app.user and not team.hasMember(app.user) %}
                        <form method="post" action="{{ path('app_team_join', {citySlug: city.slug, slug: team.slug}) }}" class="td-header-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('join_team_' ~ team.id) }}">
                            <button class="td-header-join-btn" type="submit">+ Rejoindre</button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {# Description #}
            {% if team.description %}
                <div class="td-description-card">
                    <p>{{ team.description }}</p>
                </div>
            {% endif %}

            {# Stats grid #}
            <div class="td-stats-grid">
                <div class="td-stat">
                    <div class="td-stat__val">{{ teamStats.activeDays }}</div>
                    <div class="td-stat__lbl">jours actifs</div>
                </div>
                <div class="td-stat">
                    <div class="td-stat__val">{{ teamStats.km|number_format(0) }}</div>
                    <div class="td-stat__lbl">km parcourus</div>
                </div>
                <div class="td-stat">
                    <div class="td-stat__val">{{ teamStats.points|number_format(0) }}</div>
                    <div class="td-stat__lbl">points totaux</div>
                </div>
                <div class="td-stat td-stat--orange">
                    <div class="td-stat__val">{{ teamStats.ptsPerParticipant|number_format(1) }}</div>
                    <div class="td-stat__lbl">pts / participant</div>
                </div>
            </div>

            {# Members section #}
            <div class="td-members-card">
                <div class="td-members-title">MEMBRES - CLASSEMENT INTERNE</div>
                <div class="td-members-list">
                    {% set hiddenCount = memberRanking|length > 5 ? memberRanking|length - 5 : 0 %}
                    {% for entry in memberRanking %}
                        {% set rank = loop.index %}
                        {% set isFemale = entry.user.gender and entry.user.gender.value == 'female' %}
                        {% set isMe = app.user and app.user.id == entry.user.id %}
                        {% set isPublic = entry.user.isPublicProfile %}
                        {% set colorIdx = entry.user.id % 8 %}
                        <div class="td-member-row {% if isPublic %}cursor-pointer{% endif %} {{ isMe ? 'td-member-row--me' : '' }} {{ rank > 5 ? 'td-member-extra' : '' }}" {% if isPublic %}data-href="{{ path('app_profile_public', {citySlug: city.slug, username: entry.user.username}) }}"{% endif %}>
                            <div class="td-member-rank">
                                {% if rank == 1 %}
                                    <i class="fas fa-medal fs-15 text-gold"></i>
                                {% elseif rank == 2 %}
                                    <i class="fas fa-medal fs-15 text-silver"></i>
                                {% elseif rank == 3 %}
                                    <i class="fas fa-medal fs-15 text-bronze"></i>
                                {% else %}
                                    <span class="td-rank-num">{{ rank }}</span>
                                {% endif %}
                            </div>
                            <div class="rk-team-badge rk-badge--{{ colorIdx }}">{{ entry.user.initials }}</div>
                            <div class="td-member-info">
                                <div class="td-member-name">
                                    {{ entry.user.firstName }} {{ entry.user.lastName }}
                                    {% if isMe %}<span class="td-me-badge">moi</span>{% endif %}
                                </div>
                                <div class="td-member-last">
                                    {% if entry.lastDate %}
                                        {% set daysAgo = (("now"|date('U') - entry.lastDate|date('U')) / 86400)|round %}
                                        {% if daysAgo <= 0 %}
                                            actif{{ isFemale ? 'e' : '' }} à l'instant
                                        {% elseif daysAgo == 1 %}
                                            actif{{ isFemale ? 'e' : '' }} il y a 1 jour
                                        {% else %}
                                            actif{{ isFemale ? 'e' : '' }} il y a {{ daysAgo }} jours
                                        {% endif %}
                                    {% else %}
                                        pas encore actif{{ isFemale ? 'e' : '' }}
                                    {% endif %}
                                </div>
                            </div>
                            <div class="td-member-stats">
                                <span class="td-member-km">{{ entry.km|number_format(1) }} km</span>
                                <span class="td-member-days">
                                    <strong>{{ entry.activeDays }}</strong>
                                    <small>jours</small>
                                </span>
                                <span class="td-member-pts">{{ entry.points|number_format(1) }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% if hiddenCount > 0 %}
                    <button class="td-members-more" data-reveal-target=".td-member-extra" data-reveal-hidden-class="td-member-extra">↓ Voir les {{ hiddenCount }} autres membres</button>
                {% endif %}
            </div>
        </div>{# /td-main #}

        {# ════════════════════════ SIDEBAR ════════════════════════ #}
        <div class="td-sidebar">
            {# General ranking #}
            {% if teamPosition %}
                <div class="card card--flat td-ranking-card">
                    <div class="td-sidebar-label">CLASSEMENT GÉNÉRAL</div>
                    <div class="td-ranking-rank">
                        {{ teamPosition.rank }}<sup>e</sup>
                        <span class="td-ranking-total">/ {{ teamPosition.total }} équipes</span>
                    </div>
                    {% if teamRankingGap is not null %}
                        <div class="td-ranking-gap">
                            Écart avec la {{ teamPosition.rank - 1 }}e place :&nbsp;<strong>{{ teamRankingGap|number_format(1) }} pts/pers.</strong>
                        </div>
                    {% elseif teamPosition.rank == 1 %}
                        <div class="td-ranking-gap text-primary">🥇 En tête du classement !</div>
                    {% endif %}
                    {% if teamRanking|length > 0 %}
                        {% set firstEntry = teamRanking[0] %}
                        {% set myPts = teamStats.ptsPerParticipant %}
                        {% set barPct = firstEntry.ptsPerParticipant > 0 ? (myPts / firstEntry.ptsPerParticipant * 100)|round : 0 %}
                        <div class="td-ranking-bar-wrap">
                            <div class="td-ranking-bar pct-fill" style="--pct:{{ barPct }}%"></div>
                        </div>
                        <div class="td-ranking-labels">
                            <span>1re ({{ firstEntry.team.name }} · {{ firstEntry.ptsPerParticipant|number_format(1) }})</span>
                            <span>Nous · {{ myPts|number_format(1) }}</span>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# Actions #}
            <div class="card card--flat td-actions-card">
                <div class="td-sidebar-label">ACTIONS</div>
                {% if app.user and not team.hasMember(app.user) %}
                    <form method="post" action="{{ path('app_team_join', {citySlug: city.slug, slug: team.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('join_team_' ~ team.id) }}">
                        <button class="btn btn--primary w-100" type="submit">+ Rejoindre cette équipe</button>
                    </form>
                {% elseif app.user and team.hasMember(app.user) %}
                    <form method="post" action="{{ path('app_team_leave', {citySlug: city.slug, slug: team.slug}) }}" data-confirm="Quitter l'équipe ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('leave_team_' ~ team.id) }}">
                        <button class="btn btn--outline w-100" type="submit">Quitter l'équipe</button>
                    </form>
                {% else %}
                    <p class="fs-13 text-ink-3 m-0">
                        <a href="{{ path('app_login') }}">Connectez-vous</a> pour rejoindre cette équipe.
                    </p>
                {% endif %}
            </div>

            {# Create team CTA #}
            <div class="td-create-card">
                <div class="td-create-title">VOUS NE TROUVEZ PAS VOTRE ÉQUIPE&nbsp;?</div>
                <p>Créez la vôtre en quelques secondes et invitez vos collègues ou amis.</p>
                <a href="{{ path('app_team_create', {citySlug: city.slug}) }}" class="btn btn--orange w-100 text-center">+ Créer une nouvelle équipe</a>
            </div>
        </div>{# /td-sidebar #}
    </div>{# /td-layout #}
</div>{# /home-wrap #}
{% endblock %}

