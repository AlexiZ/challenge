{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | {{ parent() }}{% endblock %}

{% block body %}
<div class="container container--narrow mt-8">
    <div class="card">
        <h1 class="card__title card__title--lg text-center mb-4">Mot de passe oublié</h1>

        {{ form_start(requestForm) }}
            <div class="form-group">
                {{ form_label(requestForm.email) }}
                {{ form_widget(requestForm.email, {attr: {class: 'form-control'}}) }}
                {{ form_errors(requestForm.email) }}
            </div>
            <button class="btn btn--primary w-full" type="submit">Envoyer le lien de réinitialisation</button>
        {{ form_end(requestForm) }}

        <div class="text-center mt-4 text-sm">
            <a href="{{ path('app_login') }}">Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
