{% extends 'base.html.twig' %}

{% block title %}Configuration | {{ parent() }}{% endblock %}

{% block body %}
<div class="page">

    <div class="adm-page-header">
        <div>
            <h1 class="adm-page-title">Configuration</h1>
            <div class="adm-page-sub">{{ city.name }} - Édition {{ cityEdition.edition.year }}</div>
        </div>
    </div>

    {% include 'city_admin/_nav.html.twig' %}

    {% if locked %}
        <div class="alert--warning">
            <i class="fas fa-lock me-1"></i> L'édition est en cours : seuls les seuils de distance suspecte sont modifiables.
        </div>
    {% endif %}

    {{ form_start(form) }}

    <div class="adm-color-grid align-items-start">
        {# ── Paramètres de l'édition ── #}
        <div class="card card--flat">
            <div class="adm-section-label mb-14px">
                <i class="fas fa-sliders fa-xs me-1"></i>Paramètres de l'édition
            </div>
            <div class="adm-param-list">
                {% for field in [form.registrationsOpen, form.tripsEntryOpen, form.photoChallengesEnabled, form.rankingsPublic] %}
                    <div class="adm-check-row adm-param-row justify-content-start">
                        {{ form_widget(field) }}
                        {{ form_label(field) }}
                    </div>
                {% endfor %}
                {# Barème commun à toute l'édition, modifiable uniquement par le super admin #}
                {% for label, value in {
                    'Points / jour actif': cityEdition.pointsPerDay,
                    'Points / km vélo': cityEdition.pointsPerKmBike,
                    'Points / km marche': cityEdition.pointsPerKmWalk,
                } %}
                    <div class="adm-param-row">
                        <span class="adm-param-label">{{ label }}</span>
                        <span class="fw-semibold">{{ value|number_format(2, ',') }}</span>
                    </div>
                {% endfor %}

                {# ── Seuils de sécurité ── #}
                {% for field in [form.suspiciousDistanceBike, form.suspiciousDistanceWalk] %}
                    <div class="adm-param-row">
                        {{ form_label(field, null, {label_attr: {class: 'adm-param-label mb-0'}}) }}
                        <span>
                            {{ form_widget(field, {attr: {class: 'form-control w-auto', size: 6}}) }}
                            {{ form_errors(field) }}
                        </span>
                    </div>
                {% endfor %}
            </div>
            <p class="text-muted fs-080rem mb-0">
                Au-delà de ces distances, un trajet apparaît dans les <a href="{{ path('app_city_admin_suspicious_trips', {citySlug: city.slug}) }}">trajets suspects</a>.
            </p>
        </div>

        {# ── Défis photo ── #}
        <div class="card card--flat">
            <div class="adm-section-label mb-14px">
                <i class="fas fa-camera fa-xs me-1"></i>Défis photo
            </div>
            <div class="table-wrapper">
                <table>
                    <thead><tr><th><span class="visually-hidden">Disponible</span></th><th>Défi</th><th>Points</th></tr></thead>
                    <tbody>
                        {% for configForm in form.bonusPhotoConfigs|sort((a, b) => a.vars.data.challenge.label() <=> b.vars.data.challenge.label()) %}
                        {% set config = configForm.vars.data %}
                        <tr class="adm-toggle-row" data-row-toggle>
                            <td>
                                {{ form_widget(configForm.enabled, {attr: {'aria-label': 'Défi « ' ~ config.challenge.label() ~ ' » disponible'}}) }}
                            </td>
                            <td>
                                <label for="{{ configForm.enabled.vars.id }}" class="mb-0">{{ config.challenge.label() }}</label>
                                <div class="text-xs text-muted mt-2px">{{ config.challenge.description() }}</div>
                            </td>
                            <td class="text-nowrap">
                                {{ form_widget(configForm.points, {attr: {class: 'form-control w-auto', size: 5}}) }}
                                {{ form_errors(configForm.points) }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="text-muted fs-080rem mt-14px mb-0">
                Seuls les défis cochés sont proposés aux participants.
            </p>
        </div>
    </div>

    <div class="text-center">
        <button class="btn btn--sm btn--primary mt-3" type="submit">
            <i class="fas fa-save me-1"></i> Enregistrer
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
