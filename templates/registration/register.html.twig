{% extends 'base.html.twig' %}

{% block title %}Inscription | {{ parent() }}{% endblock %}

{% block body %}
<div class="container container--narrow mt-6 mb-8">
    <div class="card">
        <h1 class="card__title card__title--lg text-center">Créer mon compte</h1>
        <p class="text-muted text-center text-sm mb-4">Rejoignez le challenge dans votre ville</p>

        {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}
            <div class="form-grid-2-wide">
                <div class="form-group">{{ form_label(registrationForm.firstName) }}{{ form_widget(registrationForm.firstName, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.firstName) }}</div>
                <div class="form-group">{{ form_label(registrationForm.lastName) }}{{ form_widget(registrationForm.lastName, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.lastName) }}</div>
            </div>
            <div class="form-group">{{ form_label(registrationForm.username) }}{{ form_widget(registrationForm.username, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.username) }}<div class="form-text">{{ form_help(registrationForm.username) }}</div></div>
            <div class="form-group">{{ form_label(registrationForm.email) }}{{ form_widget(registrationForm.email, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.email) }}</div>
            <div class="form-group">{{ form_label(registrationForm.city) }}{{ form_widget(registrationForm.city, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.city) }}</div>
            <div class="form-group">{{ form_label(registrationForm.plainPassword.first) }}{{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.plainPassword.first) }}</div>
            <div class="form-group">{{ form_label(registrationForm.plainPassword.second) }}{{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'form-control'}}) }}{{ form_errors(registrationForm.plainPassword.second) }}</div>

            <details class="mb-4 details-optional">
                <summary class="details-optional__summary">Informations optionnelles</summary>
                <div class="mt-3">
                    <div class="form-group">{{ form_label(registrationForm.cyclistProfile) }}{{ form_widget(registrationForm.cyclistProfile, {attr: {class: 'form-control'}}) }}</div>
                    <div class="form-group">{{ form_label(registrationForm.bikeType) }}{{ form_widget(registrationForm.bikeType, {attr: {class: 'form-control'}}) }}</div>
                    <div class="form-group">{{ form_label(registrationForm.gender) }}{{ form_widget(registrationForm.gender, {attr: {class: 'form-control'}}) }}</div>
                    <div class="form-group">{{ form_label(registrationForm.age) }}{{ form_widget(registrationForm.age, {attr: {class: 'form-control'}}) }}</div>
                    <div class="form-group">{{ form_label(registrationForm.perceivedBenefit) }}{{ form_widget(registrationForm.perceivedBenefit, {attr: {class: 'form-control'}}) }}</div>
                    <div class="form-group">{{ form_label(registrationForm.mainBarrier) }}{{ form_widget(registrationForm.mainBarrier, {attr: {class: 'form-control'}}) }}</div>
                </div>
            </details>

            <div class="form-check mb-3">{{ form_widget(registrationForm.receiveEmails) }}<label>{{ form_label(registrationForm.receiveEmails) }}</label></div>
            <div class="form-check mb-4">{{ form_widget(registrationForm.agreeTerms) }}<label>{{ form_label(registrationForm.agreeTerms) }}</label>{{ form_errors(registrationForm.agreeTerms) }}</div>

            <button class="btn btn--primary w-full" type="submit">Créer mon compte</button>
        {{ form_end(registrationForm) }}

        <div class="text-center mt-4 text-sm">
            <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
        </div>
    </div>
</div>
{% endblock %}
