{% extends 'base.html.twig' %}

{% block title %}Inscription | {{ parent() }}{% endblock %}

{% form_theme registrationForm 'form/help_tooltip_theme.html.twig' %}

{% block body %}
<div class="page">
    <div class="card">
        <h1 class="card__title card__title--lg text-center">Créer mon compte</h1>
        <p class="text-muted text-center text-sm mb-4">Rejoignez le challenge dans votre ville !</p>

        {{ form_start(registrationForm, {attr: {novalidate: 'novalidate', class: 'register-form'}}) }}
        {{ form_errors(registrationForm) }}
        <p class="text-muted text-sm mb-3"><span class="required-mark">*</span> Champs obligatoires, tous les autres sont facultatifs</p>
        <div class="form-group">
            {{ form_label(registrationForm.city) }}
            {{ form_widget(registrationForm.city, {attr: {class: 'form-control'}}) }}
            {{ form_errors(registrationForm.city) }}
        </div>
        <div class="form-group">
            {{ form_label(registrationForm.teams, null, {label_attr: {id: registrationForm.teams.vars.id ~ '_label'}}) }}
            {# Checkboxes are rebuilt client-side by assets/js/registration-teams.js when the city changes #}
            <div id="{{ registrationForm.teams.vars.id }}" class="form-control team-checkboxes js-registration-teams" role="group"
                 aria-labelledby="{{ registrationForm.teams.vars.id }}_label"
                 data-city-select="#{{ registrationForm.city.vars.id }}"
                 data-name="{{ registrationForm.teams.vars.full_name }}[]"
                 data-placeholder-no-city="Sélectionnez une ville pour pouvoir choisir une équipe"
                 data-placeholder-no-team="Aucune équipe n'existe encore dans cette ville">
                {% for team in registrationForm.teams %}
                    <div class="form-check">
                        {{ form_widget(team, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(team, null, {label_attr: {class: 'form-check-label'}}) }}
                    </div>
                {% endfor %}
            </div>
            {{ form_errors(registrationForm.teams) }}
            {# No choices before a city is picked: mark rendered so form_end doesn't output a stray label #}
            {% do registrationForm.teams.setRendered %}
        </div>
        <div class="form-grid-2-wide">
            <div class="form-group">
                {{ form_label(registrationForm.email) }}
                {{ form_widget(registrationForm.email, {attr: {class: 'form-control'}}) }}
                {{ form_errors(registrationForm.email) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.username) }}
                {{ form_widget(registrationForm.username, {attr: {class: 'form-control'}}) }}
                {{ form_errors(registrationForm.username) }}
            </div>
        </div>
        <div class="form-grid-2-wide">
            <div class="form-group">
                {{ form_label(registrationForm.firstName) }}
                {{ form_widget(registrationForm.firstName, {attr: {class: 'form-control'}}) }}
                {{ form_errors(registrationForm.firstName) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.lastName) }}
                {{ form_widget(registrationForm.lastName, {attr: {class: 'form-control'}}) }}
                {{ form_errors(registrationForm.lastName) }}
            </div>
        </div>
        <div class="form-grid-2-wide">
            <div class="form-group">
                {{ form_label(registrationForm.cyclistProfile) }}
                {{ form_widget(registrationForm.cyclistProfile, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.bikeType) }}
                {{ form_widget(registrationForm.bikeType, {attr: {class: 'form-control'}}) }}
            </div>
        </div>
        <div class="form-grid-2-wide">
            <div class="form-group">
                {{ form_label(registrationForm.gender) }}
                {{ form_widget(registrationForm.gender, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.age) }}
                {{ form_widget(registrationForm.age, {attr: {class: 'form-control'}}) }}
                {{ form_errors(registrationForm.age) }}
            </div>
        </div>
        <div class="form-grid-2-wide">
            <div class="form-group">
                {{ form_label(registrationForm.perceivedBenefit) }}
                {{ form_widget(registrationForm.perceivedBenefit, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.mainBarrier) }}
                {{ form_widget(registrationForm.mainBarrier, {attr: {class: 'form-control'}}) }}
            </div>
        </div>

        <fieldset class="register-password mb-4">
            <legend class="register-column__label">Mot de passe</legend>
            <p class="text-muted text-sm mb-3">
                Laissez vide pour une connexion rapide, sans mot de passe : vous recevrez un lien de connexion par email.
                Vous pourrez toujours ajouter un mot de passe plus tard depuis votre profil si vous le souhaitez.
            </p>
            <div class="form-group">
                {{ form_label(registrationForm.plainPassword.first) }}
                <div class="password-field">
                    {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'form-control', autocomplete: 'new-password'}}) }}
                    <button type="button" class="password-toggle-btn" data-password-toggle aria-label="Afficher le mot de passe"><i class="fas fa-eye"></i></button>
                </div>
                {{ form_errors(registrationForm.plainPassword.first) }}
            </div>
            <div class="form-group">
                {{ form_label(registrationForm.plainPassword.second) }}
                <div class="password-field">
                    {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'form-control', autocomplete: 'new-password'}}) }}
                    <button type="button" class="password-toggle-btn" data-password-toggle aria-label="Afficher le mot de passe"><i class="fas fa-eye"></i></button>
                </div>
                {{ form_errors(registrationForm.plainPassword.second) }}
            </div>
        </fieldset>

        <div class="form-check mb-4">
            {{ form_widget(registrationForm.receiveEmails) }}
            <label>{{ form_label(registrationForm.receiveEmails) }}</label>
        </div>

        <div class="text-center">
            <button class="btn btn--sm btn--primary w-full" type="submit">Créer mon compte</button>
        </div>
        {{ form_end(registrationForm) }}

        <div class="text-center mt-4 text-sm">
            <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
        </div>
    </div>
</div>
{% endblock %}
