{% extends 'base.html.twig' %}

{% set hideUserMenu = true %}

{% block title %}Connexion | {{ parent() }}{% endblock %}

{% block body %}
    <div class="container container--narrow mt-8">
        <div class="card text-center">
            {% if tokenUser.avatar %}
                <img src="{{ asset('uploads/avatars/' ~ tokenUser.avatar) }}" class="edit-avatar-preview mx-auto mb-3" alt="">
            {% endif %}

            <h1 class="card__title card__title--lg mb-2">Se connecter en tant que {{ tokenUser.fullName }}</h1>
            <p class="text-ink-3 fs-5 mb-4">{{ tokenUser.email }}</p>

            <form method="post" action="{{ path('app_login_token_confirm', {token: token}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('login_token_confirm') }}">
                <button class="btn btn--primary w-full" type="submit">Se connecter</button>
            </form>

            <div class="text-center mt-4 text-sm">
                <a href="{{ path('app_login') }}">Ce n'est pas moi ? Se connecter avec un autre compte</a>
            </div>
        </div>
    </div>
{% endblock %}
