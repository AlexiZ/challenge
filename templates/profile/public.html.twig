{% extends 'base.html.twig' %}

{% block title %}{{ profileUser.fullName }} | {{ parent() }}{% endblock %}

{% block body %}
    {# ── calculs utiles ─────────────────────────────────────────────────────── #}
    {% set bikePoints = (stats.km_bike  * cityEdition.pointsPerKmBikeFor(profileUser))|round(1) %}
    {% set walkPoints = (stats.km_walk  * cityEdition.pointsPerKmWalk)|round(1) %}
    {% set dayPoints  = (stats.active_days * cityEdition.pointsPerDay)|round(1) %}
    {% set totalDays  = cityEdition.edition.getDurationDays() %}

    {# mode de déplacement par date : 'bike', 'walk' ou 'both' #}
    {% set dayModes = {} %}
    {% for trip in trips %}
        {% set d = trip.tripDate|date('Y-m-d') %}
        {% set cur = dayModes[d] ?? '' %}
        {% if trip.mode.value == 'bike' %}
            {% set dayModes = dayModes|merge({(d): (cur == 'walk' ? 'both' : 'bike')}) %}
        {% else %}
            {% set dayModes = dayModes|merge({(d): (cur == 'bike' ? 'both' : 'walk')}) %}
        {% endif %}
    {% endfor %}

    <div class="page">
    {# ── En-tête de page ──────────────────────────────────────────────── #}
    <div class="mc-page-header">
        <div>
            <h1 class="mc-page-title">{{ isSelf ? 'Mon profil public' : profileUser.fullName }}</h1>
            <div class="mc-page-sub">
                <i class="fas fa-map-location-dot fa-sm"></i>
                {{ city.name }} - Édition {{ cityEdition.edition.year }}
            </div>
        </div>
    </div>

    <div class="pub-layout">
        {# ════════════════════════════ BARRE LATÉRALE ════════════════════════ #}
        <aside class="pub-sidebar">
            {# Identité #}
            <div class="pub-identity">
                {% if profileUser.avatar %}
                    <img src="{{ asset('uploads/avatars/' ~ profileUser.avatar) }}" class="pub-avatar pub-avatar--photo" alt="Photo de {{ profileUser.fullName }}">
                {% else %}
                    <div class="pub-avatar">{{ profileUser.initials }}</div>
                {% endif %}
                <div class="pub-name">{{ profileUser.fullName }}</div>
                <div class="pub-username">@{{ profileUser.username }}</div>
            </div>

            {# Infos profil #}
            <div class="pub-info-table">
                {% if profileUser.cyclistProfile %}
                <div class="pub-info-row">
                    <span class="pub-info-label">Profil cycliste</span>
                    <span class="pub-info-val">{{ profileUser.cyclistProfile.label() }}</span>
                </div>
                {% endif %}
                {% if profileUser.bikeType %}
                <div class="pub-info-row">
                    <span class="pub-info-label">Type de vélo</span>
                    <span class="pub-info-val">{{ profileUser.bikeType.label() }}</span>
                </div>
                {% endif %}
                {% if profileUser.gender %}
                <div class="pub-info-row">
                    <span class="pub-info-label">Genre</span>
                    <span class="pub-info-val">{{ profileUser.gender.label() }}</span>
                </div>
                {% endif %}
                {% if profileUser.age %}
                <div class="pub-info-row">
                    <span class="pub-info-label">Âge</span>
                    <span class="pub-info-val">{{ profileUser.age }} ans</span>
                </div>
                {% endif %}
            </div>

            {# Boutons (propre profil) #}
            {% if isSelf %}
                <div class="pub-actions">
                    <a href="{{ path('app_profile', {citySlug: city.slug}) }}" class="btn btn--outline btn--sm flex-1-center">
                        <i class="fas fa-pen fa-sm"></i> Modifier mon profil
                    </a>
                </div>
            {% endif %}

            {# Mes équipes #}
            {% set cityTeams = [] %}
            {% for team in profileUser.teams %}
                {% if team.city.id == city.id %}
                    {% set cityTeams = cityTeams|merge([team]) %}
                {% endif %}
            {% endfor %}

            {% if cityTeams is not empty %}
                <div class="pub-teams-section">
                    <div class="mc-section-label"><i class="fas fa-people-group fa-xs me-1"></i>{{ isSelf ? 'Mes équipes' : 'Équipes' }}</div>
                    {% for team in cityTeams %}
                        <a href="{{ path('app_team_show', {citySlug: city.slug, slug: team.slug}) }}" class="pub-team-card">
                            <span class="pub-team-name">{{ team.name }}</span>
                        </a>
                    {% endfor %}
                    {% if isSelf %}
                        <a href="{{ path('app_participants', {citySlug: city.slug}) }}" class="btn btn--outline btn--sm mt-2 w-100 text-center">
                            + Rejoindre une équipe
                        </a>
                    {% endif %}
                </div>
            {% elseif not isSelf %}
                <div class="pub-teams-section">
                    <a href="{{ path('app_team_create', {citySlug: city.slug}) }}" class="btn btn--outline btn--sm w-100 text-center">
                        + Rejoindre une équipe
                    </a>
                </div>
            {% endif %}
        </aside>

        {# ════════════════════════════ CONTENU PRINCIPAL ════════════════════ #}
        <main class="mc-main">
            {# ── Cartes de stats ───────────────────────────────────────────── #}
            <div class="mc-stats-row">
                <div class="mc-stat-card">
                    <div class="mc-stat-eyebrow">
                        <i class="fas fa-calendar-check fa-xs"></i> Jours actifs
                    </div>
                    <div class="mc-stat-big">{{ stats.active_days }}</div>
                    <div class="mc-stat-sub">sur {{ totalDays }} jours du challenge</div>
                </div>

                <div class="mc-stat-card">
                    <div class="mc-stat-eyebrow">
                        <i class="fas fa-route fa-xs"></i> Distance
                    </div>
                    <div class="mc-stat-big">
                        {{ stats.km_total|number_format(0, '.', ' ') }}<span class="mc-stat-unit">km</span>
                    </div>
                    <div class="mc-stat-breakdown">
                        <span><i class="fas fa-bicycle fa-xs text-primary"></i>
                            {{ stats.km_bike|number_format(2) }} km</span>
                        <span><i class="fas fa-person-walking fa-xs text-orange"></i>
                            {{ stats.km_walk|number_format(2) }} km</span>
                    </div>
                </div>

                <div class="mc-stat-card">
                    <div class="mc-stat-eyebrow">
                        <i class="fas fa-star fa-xs"></i> Points cumulés
                    </div>
                    <div class="mc-stat-big text-orange">
                        {{ stats.total_points|number_format(1) }}
                    </div>
                    <div class="mc-stat-breakdown mc-stat-breakdown--col">
                        <span><i class="fas fa-bicycle fa-xs text-primary"></i>
                            +{{ bikePoints }} pts vélo</span>
                        <span><i class="fas fa-person-walking fa-xs text-orange"></i>
                            +{{ walkPoints }} pts marche</span>
                        <span><i class="fas fa-calendar-days fa-xs text-ink-3"></i>
                            +{{ dayPoints }} pts jours</span>
                        {% if stats.bonus_points > 0 %}
                            <span><i class="fas fa-camera fa-xs text-secondary"></i>
                            +{{ stats.bonus_points }} pts bonus</span>
                        {% endif %}
                    </div>
                </div>

                <div class="mc-stat-card">
                    <div class="mc-stat-eyebrow">
                        <i class="fas fa-leaf fa-xs"></i> CO₂ évité
                    </div>
                    <div class="mc-stat-big text-green">
                        {{ stats.co2_kg|number_format(0, '.', ' ') }}<span class="mc-stat-unit">kg</span>
                    </div>
                    <div class="mc-stat-sub">économisés</div>
                </div>
            </div>

            {# ── Heatmap ───────────────────────────────────────────────────── #}
            <div class="mc-section">
                <div class="mc-section-label">
                    <i class="fas fa-calendar-days fa-xs me-1"></i>Jours de participation
                </div>
                <div class="mc-progress-block mb-0">
                    <div class="heatmap">
                        {% if cityEdition.edition.startDate and cityEdition.edition.endDate %}
                            {% set startTs  = cityEdition.edition.startDate|date('U') %}
                            {% set endTs    = cityEdition.edition.endDate|date('U') %}
                            {% set nowTs    = 'now'|date('U') %}
                            {% set dayCount = (((endTs - startTs) / 86400)|round) + 1 %}
                            {% for i in 0..(dayCount - 1) %}
                                {% set dayTs  = startTs + (i * 86400) %}
                                {% set dayKey = dayTs|date('Y-m-d') %}
                                {% set mode   = dayModes[dayKey] ?? '' %}
                                {% set isPast = dayTs <= nowTs %}
                                {% if not isPast %}
                                    <div class="heatmap-day heatmap-day--future" title="{{ dayKey }}"></div>
                                {% elseif mode == '' %}
                                    <div class="heatmap-day" title="{{ dayKey }}"></div>
                                {% else %}
                                    <div class="heatmap-day" data-mode="{{ mode }}" title="{{ dayKey }}"></div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="pub-heatmap-legend">
                        <span class="pub-legend-dot pub-legend-dot--both"></span> Vélo + marche &nbsp;
                        <span class="pub-legend-dot pub-legend-dot--bike"></span> Vélo seulement &nbsp;
                        <span class="pub-legend-dot pub-legend-dot--walk"></span> Marche seulement &nbsp;
                        <span class="pub-legend-dot pub-legend-dot--none"></span> Pas de trajet
                    </div>
                </div>
            </div>

            {# ── Trajets ───────────────────────────────────────────────────── #}
            <div class="mc-section">
                <div class="mc-section-label">
                    <i class="fas fa-list-ul fa-xs me-1"></i>Mes trajets
                </div>
                {% if trips is empty %}
                    <p class="text-ink-3 fs-14">Aucun trajet saisi pour cette édition.</p>
                {% else %}
                    {% set maxTripsAtStartup = 6 %}
                    <div class="mc-trips-list">
                        {% for trip in trips %}
                            <div class="mc-trip-row {% if loop.index > maxTripsAtStartup %}d-none{% endif %}">
                                <span class="mc-trip-icon {{ trip.mode.value == 'bike' ? 'bike' : 'walk' }}">
                                    <i class="{{ trip.mode.faIcon() }}"></i>
                                </span>
                                <span class="mc-trip-date">{{ trip.tripDate|date('d/m/Y') }}</span>
                                <span class="mc-trip-mode">{{ trip.mode.label() }}</span>
                                <span class="mc-trip-dist">{{ trip.distanceKm|number_format(2) }} km</span>
                                {% include 'components/_trip_points.html.twig' with {user: profileUser} %}
                            </div>
                        {% endfor %}
                    </div>
                    {% if trips|length > maxTripsAtStartup %}
                        <div class="text-center mt-12px">
                            <button type="button" class="orga-link d-inline-flex fs-13 bg-transparent border-0 p-0" data-reveal-target=".mc-trip-row.d-none">
                                <i class="fas fa-chevron-down"></i> Voir les {{ trips|length - maxTripsAtStartup }} trajets précédents
                            </button>
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            {# ── Défis photo ───────────────────────────────────────────────── #}
            <div class="mc-section">
                <div class="mc-section-label">
                    <i class="fas fa-camera fa-xs me-1"></i>Mes défis photo
                </div>
                {% if bonusPhotos is empty %}
                    <p class="text-ink-3 fs-14">Aucun défi photo validé pour cette édition.</p>
                {% else %}
                    <div class="mc-photo-list">
                        {% for photo in bonusPhotos %}
                            <div class="mc-photo-row">
                                <div class="mc-photo-info">
                                    <div class="mc-photo-name">{{ photo.challenge.label() }}</div>
                                    <div class="mc-photo-desc">Soumis le {{ photo.submittedAt|date('d/m/Y') }}</div>
                                </div>
                                <div class="mc-photo-pts">+{{ (photo.pointsAwarded ?? 0)|number_format(0) }} pts</div>
                                {# Photo visible only if the author consented to publish it (or is viewing their own profile) #}
                                {% if photo.photo and (photo.consentToPublish or isSelf) %}
                                    <button type="button" class="pub-photo-btn js-lightbox"
                                            data-src="{{ asset('uploads/bonus_photos/' ~ photo.photo) }}"
                                            data-alt="{{ photo.challenge.label() }}"
                                            title="Voir la photo" aria-label="Voir la photo">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </main>
    </div>{# /pub-layout #}
    </div>
{% endblock %}

