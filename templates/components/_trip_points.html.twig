{# Trip points badge with calculation detail on hover. Expects: trip, user, cityEdition, dayPointTripIds #}
{% set hasDayPoint = trip.id in dayPointTripIds %}
{% set tripPoints = trip.pointsGenerated + (hasDayPoint ? cityEdition.pointsPerDay : 0) %}
{% set kmRate = trip.mode.value == 'bike' ? cityEdition.pointsPerKmBikeFor(user) : cityEdition.pointsPerKmWalk %}
{% set detail = (hasDayPoint ? (cityEdition.pointsPerDay|number_format(2) ~ ' pt jour actif + ') : '') ~ trip.distanceKm|number_format(2) ~ 'km * ' ~ kmRate|number_format(2) ~ ' pts' %}
<span class="mc-trip-pts" title="{{ detail }}">+{{ tripPoints|number_format(2) }} pts</span>
