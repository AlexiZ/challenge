#!/usr/bin/env bash
# -*- shell-script -*-

function docker_compose_exec() {
    if [[ $(uname -s) != "Darwin" ]]; then
        docker compose exec -u $(id -u):$(id -g) "$@"
    else
        docker compose exec "$@"
    fi
}

function php() {
    docker_compose_exec php php "$@"
}

function composer() {
    docker_compose_exec php php -d memory_limit=-1 /usr/bin/composer "$@"
}

function sf() {
    docker_compose_exec php bin/console "$@"
}

function deployer() {
    # Pas de docker_compose_exec ici : Deployer doit tourner en root dans le
    # conteneur (cf. compose.yaml), sinon `~` ne résout à aucun utilisateur
    # (uid hôte sans entrée /etc/passwd) et SSH/Deployer échouent en cascade.
    docker compose exec php vendor/bin/dep "$@"
}

echo php composer sf deployer
